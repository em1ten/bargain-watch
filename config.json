{
  "_comment": "Bargain Watch config. All management happens here in the repo (protected by your GitHub login) - the dashboard itself is read-only. 'my_sizes' powers the your-size flag per category. 'discovery_pool' brands rotate automatically: 3 are scanned each day and tagged as Discovery on the feed. 'rrp' is a rough typical retail price used for discount scoring - tune as needed.",
  "domain": "www.vinted.co.uk",
  "currency": "GBP",
  "max_items_per_watch": 40,
  "bargain_threshold_pct": 50,
  "bargain_max_price": 20,
  "discovery_per_day": 3,
  "feed_size": 60,

  "my_sizes": {
    "denim":    ["W36", "36", "W35", "W37"],
    "tops":     ["L"],
    "footwear": ["9", "UK 9", "43"]
  },

  "global_exclude": ["kids", "toy", "doll", "replica", "fake", "case", "phone", "figure", "sticker", "decal"],

  "watches": [
    { "name": "Nudie Jeans",     "search_text": "nudie jeans",     "price_to": 60,  "rrp": 140, "size_category": "denim",    "notify": "instant" },
    { "name": "Edwin",           "search_text": "edwin jeans",     "price_to": 60,  "rrp": 150, "size_category": "denim",    "notify": "instant" },
    { "name": "Momotaro",        "search_text": "momotaro jeans",  "price_to": 150, "rrp": 350, "size_category": "denim",    "notify": "instant" },
    { "name": "Iron Heart",      "search_text": "iron heart",      "price_to": 150, "rrp": 300, "size_category": "denim",    "notify": "instant",
      "exclude": ["necklace", "pendant", "earring", "bracelet", "valentine", "love heart", "heart print", "heart mug", "heart charm", "heart ring", "teddy"] },
    { "name": "Tellason",        "search_text": "tellason",        "price_to": 100, "rrp": 230, "size_category": "denim",    "notify": "instant" },
    { "name": "Roy Denim",       "search_text": "roy denim",       "price_to": 100, "rrp": 220, "size_category": "denim",    "notify": "instant" },
    { "name": "Universal Works", "search_text": "universal works", "price_to": 60,  "rrp": 150, "size_category": "tops",     "notify": "instant",
      "exclude": ["plug", "adapter", "socket", "charger", "extension lead"] },
    { "name": "Carhartt WIP",    "search_text": "carhartt wip",    "price_to": 50,  "rrp": 110, "size_category": "tops",     "notify": "digest" },
    { "name": "Folk Clothing",   "search_text": "folk clothing",   "price_to": 60,  "rrp": 140, "size_category": "tops",     "notify": "digest" },
    { "name": "Norse Projects",  "search_text": "norse projects",  "price_to": 60,  "rrp": 150, "size_category": "tops",     "notify": "digest" },
    { "name": "Red Wing",        "search_text": "red wing boots",  "price_to": 120, "rrp": 230, "size_category": "footwear", "notify": "digest" },
    { "name": "Selvedge denim",  "search_text": "selvedge",        "price_to": 60,              "size_category": "denim",    "notify": "digest" },
    { "name": "Uniqlo",          "search_text": "uniqlo",          "price_to": 25,              "size_category": "tops",     "notify": "off" }
  ],

  "discovery_pool": [
    { "name": "Arpenteur",       "search_text": "arpenteur",        "price_to": 80,  "rrp": 180, "size_category": "tops" },
    { "name": "A.P.C.",          "search_text": "apc jeans",        "price_to": 70,  "rrp": 180, "size_category": "denim" },
    { "name": "Our Legacy",      "search_text": "our legacy",       "price_to": 80,  "rrp": 200, "size_category": "tops" },
    { "name": "Stan Ray",        "search_text": "stan ray",         "price_to": 40,  "rrp": 90,  "size_category": "tops" },
    { "name": "Margaret Howell", "search_text": "margaret howell",  "price_to": 80,  "rrp": 250, "size_category": "tops" },
