    { "name": "Solovair",        "search_text": "solovair",         "price_to": 80,  "rrp": 180, "size_category": "footwear" },
    { "name": "Loake",           "search_text": "loake",            "price_to": 80,  "rrp": 220, "size_category": "footwear" },
    { "name": "Sanders",         "search_text": "sanders shoes",    "price_to": 80,  "rrp": 220, "size_category": "footwear" },
